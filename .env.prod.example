# Copie a .env.prod y complete. NUNCA se sube al repositorio.
#
# Y páselo SIEMPRE con --env-file, o el arranque abortará diciendo que falta
# POSTGRES_PASSWORD aunque esté aquí:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Genere la clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# El dominio por el que se entra. Sin esto Django responde 400 a todo.
ALLOWED_HOSTS=sibu.unl.edu.ec

# El MISMO dominio, con esquema. Si falta o no coincide, el sitio arranca,
# todas las páginas responden 200 y NADIE puede iniciar sesión: el 403 solo
# aparece al enviar el primer formulario. `check --deploy` lo avisa (sibu.E022).
CSRF_TRUSTED_ORIGINS=https://sibu.unl.edu.ec

# Base de datos (el compose arma DATABASE_URL con estos)
POSTGRES_DB=sibu
POSTGRES_USER=sibu
POSTGRES_PASSWORD=

# Correo institucional. El portal del estudiante depende de esto: sin SMTP
# nadie puede vincular su cuenta, porque el código de verificación viaja al
# correo institucional y esa es la prueba de identidad.
EMAIL_HOST=smtp.unl.edu.ec
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=bienestar@unl.edu.ec
ADMIN_EMAIL=soporte@unl.edu.ec

# Cuántos procesos atienden peticiones. Regla habitual: 2 × núcleos + 1.
# En la máquina AMD gratuita de Oracle (1 núcleo, 1 GB) use 2 y añada swap;
# en la ARM Ampere (4 núcleos, 24 GB) puede subir a 9.
GUNICORN_WORKERS=3

# Opcionales: sin ellos el sistema funciona y lo dice.
SENTRY_DSN=
FIRMA_PROVIDER=deshabilitada
TALLERES_ALMACEN=local
