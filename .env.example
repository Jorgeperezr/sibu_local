# ---------------------------------------------------------------------------
# SIBU — variables de entorno de PRODUCCIÓN
#
# EN DESARROLLO (Codespaces) NO HACE FALTA: `make up` arranca sin .env. Copiar
# este archivo tal cual a .env impide el arranque, porque SECRET_KEY va vacía a
# propósito y Django aborta con "The SECRET_KEY setting must not be empty".
#
# Para un servidor real: copie a .env y COMPLETE los valores vacíos.
# NUNCA versione el .env real. Verifique con: python manage.py check --deploy
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False

# Genere una nueva: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Dominios reales. NUNCA "*".
ALLOWED_HOSTS=sibu.unl.edu.ec
# Obligatorio detrás de proxy con HTTPS, o los POST fallarán con error de CSRF.
CSRF_TRUSTED_ORIGINS=https://sibu.unl.edu.ec

# PostgreSQL 16
DATABASE_URL=postgres://usuario:clave@localhost:5432/sibu
DB_CONN_MAX_AGE=60
DB_SSLMODE=require

# Volumen persistente con copias de seguridad. NUNCA bajo /tmp.
MEDIA_ROOT=/var/lib/sibu/media
LOG_FILE=/var/log/sibu/sibu.log

# Correo institucional. Sin esto, NADIE puede vincular su cuenta del portal.
EMAIL_HOST=smtp.unl.edu.ec
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=bienestar@unl.edu.ec
ADMIN_EMAIL=soporte@unl.edu.ec

# --- Firma electrónica -----------------------------------------------------
# "deshabilitada" (por defecto) | "firmaec"
# Con "deshabilitada" el sistema funciona: los documentos se generan y
# descargan sin firmar. Actívela cuando el MINTEL registre a la UNL.
FIRMA_PROVIDER=deshabilitada

FIRMAEC_SERVICIO_URL=https://impws.firmadigital.gob.ec/servicio
FIRMAEC_SISTEMA=
FIRMAEC_API_KEY=
# DISTINTA de la anterior: son credenciales de sentidos opuestos.
FIRMAEC_CALLBACK_API_KEY=
FIRMAEC_PREPRODUCCION=True

# ATENCIÓN: en True, los informes de Psicología pueden salir hacia el firmador.
# Solo si FirmaEC corre en infraestructura de la propia UNL.
FIRMAEC_DESCENTRALIZADO_PROPIO=False

# --- Talleres --------------------------------------------------------------
# "local" (por defecto) | "gdrive"
TALLERES_ALMACEN=local
GOOGLE_CLIENT_SECRETS=
GOOGLE_SHARED_DRIVE_ID=
# JSON de la cuenta de servicio, en una línea, para volcar el historial de
# atenciones a una hoja de Google. Vacío = la pantalla ofrece solo el CSV.
# La hoja debe estar compartida con el correo de esa cuenta CON PERMISO DE EDITOR.
GOOGLE_CREDENCIALES_JSON=

# --- Observabilidad (opcional) ---------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
